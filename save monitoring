import os
import time
import csv
from datetime import datetime
from dynamixel_sdk import *

# --- 설정 값 ---
DEVICENAME = 'COM7'
BAUDRATE = 57600
PROTOCOL_VERSION = 2.0

# ---------------------------------------------------------------------
# [데이터 분석 포인트] 타깃 ID를 리스트 형태로 입력받도록 구조 변경
DXL_IDS = [2, 1, 0] 
# ---------------------------------------------------------------------

ADDR_PRO_PRESENT_POSITION = 132

current_run_time = datetime.now().strftime("%Y%m%d_%H%M%S")
FILENAME = f"motor_position_monitor_{current_run_time}.csv"

portHandler = PortHandler(DEVICENAME)
packetHandler = PacketHandler(PROTOCOL_VERSION)

if not portHandler.openPort():
    print("포트 열기 실패")
    quit()

if not portHandler.setBaudRate(BAUDRATE):
    print("통신 속도 설정 실패")
    quit()

print(f"다중 모터({len(DXL_IDS)}개) 위치 모니터링 및 데이터 저장을 시작합니다.")
print(f"대상 ID: {DXL_IDS}")
print(f"저장 파일명: {FILENAME}\n")

try:
    with open(FILENAME, mode='w', newline='', encoding='utf-8') as file:
        csv_writer = csv.writer(file)
        
        # 데이터 분석을 위한 동적 CSV 헤더 생성 (예: Timestamp, Pos_ID11, Pos_ID12, Pos_ID13)
        headers = ['Timestamp'] + [f'Pos_ID{motor_id}' for motor_id in DXL_IDS]
        csv_writer.writerow(headers)

        while True:
            positions = []
            error_occurred = False

            # 등록된 ID 리스트를 순회하며 순차적으로 데이터 요청 및 수신
            for dxl_id in DXL_IDS:
                dxl_present_position, dxl_comm_result, dxl_error = packetHandler.read4ByteTxRx(
                    portHandler, dxl_id, ADDR_PRO_PRESENT_POSITION)

                if dxl_comm_result != COMM_SUCCESS:
                    print(f"\n[ID:{dxl_id}] 통신 에러: {packetHandler.getTxRxResult(dxl_comm_result)}")
                    error_occurred = True
                    positions.append(None) # 에러 시 결측치(Null) 처리
                elif dxl_error != 0:
                    print(f"\n[ID:{dxl_id}] 하드웨어 에러: {packetHandler.getRxPacketError(dxl_error)}")
                    error_occurred = True
                    positions.append(None)
                else:
                    if dxl_present_position > 2147483647:
                        dxl_present_position -= 4294967296
                    positions.append(dxl_present_position)

            # 모든 모터의 데이터를 수집한 직후의 시간 기록
            current_timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')[:-3]
            
            # CSV 파일에 한 줄(Row)로 병합하여 기록
            csv_writer.writerow([current_timestamp] + positions)
            
            # 터미널 화면 출력 갱신 (에러가 없을 때만 실시간 위치 표기)
            if not error_occurred:
                # 동적으로 여러 모터의 위치 문자열 생성
                pos_str = " | ".join([f"ID{i}:{p:6d}" for i, p in zip(DXL_IDS, positions)])
                print(f"\r시간: {current_timestamp} | {pos_str} ", end="")

            time.sleep(0.05)

except KeyboardInterrupt:
    print("\n\n모니터링을 종료하고 데이터 저장을 완료합니다.")

finally:
    portHandler.closePort()
