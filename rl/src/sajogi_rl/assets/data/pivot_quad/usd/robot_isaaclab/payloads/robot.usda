#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "pivot_assembly_for_urdf2"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "pivot_assembly_for_urdf2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "revolute_4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_29" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_31" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_28" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_30" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_36" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_39" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_37" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "revolute_38" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "pivot_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "thigh__2__1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "calf_1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }

                over "thigh__1__1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "calf__3__1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }
            }

            over "thigh__3__1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "calf__1__1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "thigh_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "calf__2__1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }
}

